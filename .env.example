# Copy to backend/.env; uvicorn --env-file needs python-dotenv, or export variables in your shell.
# Recommended: use the startup instructions in README (shell exports / PowerShell).
NOTEPILOT_DATA=./data
# Server-side only. Never put keys in VITE_* or commit .env.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
# xiaohongshu-mcp standalone REST service; must be already running and logged in.
XHS_BASE_URL=http://127.0.0.1:18060
# Optional multimodal analysis of real reference covers.
VISION_MODEL=
# Optional OpenAI-compatible images/generations; requires b64_json response.
IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_API_KEY=
IMAGE_MODEL=
# Optional official Douyin chart access, with approved data.external.billboard_music scope.
DOUYIN_CLIENT_TOKEN=
