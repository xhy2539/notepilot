# Mac first-run wizard creates backend/.env. Never commit keys or cookies.
NOTEPILOT_DATA=./data
# One Bailian API Key is shared by text, vision and image generation.
DASHSCOPE_API_KEY=
LLM_PROVIDER=bailian
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
VISION_MODEL=qwen-vl-plus
# Optional overrides for other OpenAI-compatible providers.
LLM_API_KEY=
IMAGE_PROVIDER=bailian
IMAGE_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL=qwen-image-2.1-turbo
# Mac launcher runs the pinned read-only research service on loopback.
XHS_BASE_URL=http://127.0.0.1:18060
XHS_API_TOKEN=
# Optional approved Douyin music chart access. Empty = use imported candidates.
DOUYIN_CLIENT_TOKEN=
